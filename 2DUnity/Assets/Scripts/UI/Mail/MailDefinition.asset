  m_Script: {fileID: 11500000, guid: a2c39b895386a2e4d94d57d2549eba7c, type: 3}
  m_Name: MailDefinition
  m_EditorClassIdentifier: 
  mailId: M001
  listTitle: "\uBCF8\uBD80 \uACF5\uBB38"
  title: "\uC81C\uBAA9: [\uC548\uB0B4] \uC2E0\uADDC \uBC30\uCE58 \uC5F0\uAD6C\uC6D0
    \uD658\uC601 \uBC0F \uC81C1\uCC28 \uAE30\uB85D \uC811\uC218"
  body: "\uADC0\uD558\uC758 \uBB34\uAD81\uD55C \uBC1C\uC804\uACFC \uC548\uC804\uC744
    \uAE30\uC6D0\uD569\uB2C8\uB2E4.\r\n\r\n\uAD6D\uC81C \uD574\uC591 \uAD00\uB9AC
    \uC13C\uD130 \uB300\uD55C\uBBFC\uAD6D \uC9C0\uBD80 \uC81C1\uC5F0\uAD6C\uC18C
    \uC18C\uC18D xxx \uC5F0\uAD6C\uC6D0\uB2D8 \uC548\uB155\uD558\uC2ED\uB2C8\uAE4C.\r\n\uAD6D\uC81C
    \uD574\uC591 \uAD00\uB9AC \uC13C\uD130 \uBCF8\uBD80 \uB300\uB9AC\uC778 K \uC785\uB2C8\uB2E4.\r\n\r\n\uAE08\uC77C
    \uADC0\uD558\uC758 \uC81C1\uCC28 \uD604\uC7A5 \uD65C\uB3D9 \uAE30\uB85D\uC774
    \uBCF8\uBD80 \uAD00\uC81C \uC2DC\uC2A4\uD15C\uC5D0 \uC815\uC0C1 \uC811\uC218\uB418\uC5C8\uC74C\uC744
    \uC54C\uB824\uB4DC\uB9BD\uB2C8\uB2E4.\r\n\uADC0\uD558\uAC00 \uD68C\uC218\uD55C
    \uD45C\uBCF8\uC740 \uADDC\uC815\uC5D0 \uB530\uB77C \uC790\uB3D9 \uBD84\uB958
    \uBC0F \uBCF4\uAD00 \uCC98\uB9AC\uB418\uC5C8\uC73C\uBA70,\r\n\uD574\uB2F9 \uAE30\uB85D\uC740
    \uCD94\uD6C4 \uC5F0\uAD6C \uC790\uB8CC\uB85C \uD65C\uC6A9\uB420 \uC608\uC815\uC785\uB2C8\uB2E4.\r\n\r\n\uB610\uD55C,
    \uADC0\uD558\uC758 \uACC4\uC815\uC5D0\uB294 \uB2E4\uC74C \uAE30\uB2A5\uC774 \uD65C\uC131\uD654\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\r\n\r\n1.
    \uB3C4\uAC10 \uAE30\uB85D \uC5F4\uB78C \uAD8C\uD55C(\uAE30\uBCF8)\r\n\r\n2. \uD604\uC7A5
    \uD45C\uBCF8 \uC790\uB3D9 \uBD84\uB958 \uAE30\uB85D(\uAE30\uBCF8)\r\n\r\n3. \uC13C\uD130
    \uACF5\uC9C0 \uC218\uC2E0\uD568(\uAE30\uBCF8)\r\n\r\n\uD604\uC7A5 \uD65C\uB3D9\uC740
    \uBC18\uBCF5\uB420\uC218\uB85D \uCD95\uC801\uB41C \uAE30\uB85D\uC758 \uAC00\uCE58\uAC00
    \uB192\uC544\uC9C0\uBA70,\r\n\uADC0\uD558\uC758 \uD0D0\uC0AC\uB294 \uB300\uD55C\uBBFC\uAD6D
    \uAD00\uD560 \uD574\uC5ED \uC5F0\uAD6C\uB294 \uBB3C\uB860, \r\n\uC13C\uD130\uC758
    \uD0C0 \uC9C0\uC5ED \uD574\uC5ED \uC5F0\uAD6C\uC5D0\uB3C4 \uAE30\uC5EC\uD560
    \uAC83\uC73C\uB85C \uAE30\uB300\uB429\uB2C8\uB2E4.\r\n\r\n\uC55E\uC73C\uB85C\uC758
    \uD65C\uB3D9 \uB610\uD55C \uC548\uC804\uD558\uAC8C \uC218\uD589\uD574 \uC8FC\uC2DC\uAE30
    \uBC14\uB78D\uB2C8\uB2E4.\r\n\uAC10\uC0AC\uD569\uB2C8\uB2E4.\r\n\r\n\uAD6D\uC81C
    \uD574\uC591 \uAD00\uB9AC \uC13C\uD130\r\n\uBCF8\uBD80 \uB300\uB9AC\uC778 K \uB4DC\uB9BC "
